# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# OpenAI — used by LangChain, RAGAS, and evaluation scripts
OPENAI_API_KEY=sk-...

# Anthropic — used for Claude-based guardrail demos
ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face — model downloads and dataset access
HF_TOKEN=hf_...

# Groq — fast inference endpoint (Llama-3, Mixtral, etc.)
GROQ_API_KEY=gsk_...
